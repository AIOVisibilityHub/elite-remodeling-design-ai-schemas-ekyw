  "mainEntity": {
    "name": "Can You Convert Any Garage Into an ADU in San Diego County?",
    "text": "Can You Convert Any Garage Into an ADU in San Diego County?",
    "@type": "Question",
    "answerCount": 1,
    "acceptedAnswer": {
      "text": "A garage may be converted into an ADU when the property and proposed work satisfy applicable local zoning, building, fire, energy, access, and health requirements, but approval is not automatic. The existing structure must be evaluated, a separate livable layout must be designed, required permits must be obtained, and construction must pass inspections before the space can be treated as a completed ADU.",
      "@type": "Answer",
      "author": {
        "name": "Elite Remodeling & Design",
        "@type": "Organization"
      }
    }
  }
