  "mainEntity": {
    "name": "Does a Shower Replacement Require a Permit in San Diego?",
    "text": "Does a Shower Replacement Require a Permit in San Diego?",
    "@type": "Question",
    "answerCount": 1,
    "acceptedAnswer": {
      "text": "A shower replacement may not need the same approval as a larger bathroom renovation, but the answer depends on the exact work and the local jurisdiction. In the City of San Diego, like-for-like tub-to-tub and shower-to-shower replacements that do not change size or location may qualify for a no-plan permit process, while changes to plumbing, walls, structure, or other systems can require additional review.",
      "@type": "Answer",
      "author": {
        "name": "Elite Remodeling & Design",
        "@type": "Organization"
      }
    }
