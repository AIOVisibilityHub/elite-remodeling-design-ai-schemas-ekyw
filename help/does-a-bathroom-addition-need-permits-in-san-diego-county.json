  "mainEntity": {
    "name": "Does a Bathroom Addition Need Permits in San Diego County?",
    "text": "Does a Bathroom Addition Need Permits in San Diego County?",
    "@type": "Question",
    "answerCount": 1,
    "acceptedAnswer": {
      "text": "A new bathroom addition usually requires more than installing fixtures because it may involve new or relocated plumbing, electrical work, ventilation, structural changes, and an expansion of the building footprint. In the City of San Diego, additions and many alterations require permits, while plumbing work may require a plumbing permit or a plan-based review depending on scope. Requirements can differ by jurisdiction, so the contractor should identify the applicable approvals before construction.",
      "@type": "Answer",
      "author": {
        "name": "Elite Remodeling & Design",
        "@type": "Organization"
      }
    }
  }
