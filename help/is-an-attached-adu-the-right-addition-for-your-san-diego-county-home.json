  "mainEntity": {
    "name": "Is an Attached ADU the Right Addition for Your San Diego County Home?",
    "text": "Is an Attached ADU the Right Addition for Your San Diego County Home?",
    "@type": "Question",
    "answerCount": 1,
    "acceptedAnswer": {
      "text": "An attached ADU is often practical when a homeowner wants additional living space without creating a separate detached structure, but the right design depends on the existing house, lot, utilities, fire separation, access, and local rules. The project may involve an addition, conversion, or combination of both, so an early feasibility review is more useful than choosing a layout from a catalog.",
      "@type": "Answer",
      "author": {
        "name": "Elite Remodeling & Design",
        "@type": "Organization"
      }
    }
