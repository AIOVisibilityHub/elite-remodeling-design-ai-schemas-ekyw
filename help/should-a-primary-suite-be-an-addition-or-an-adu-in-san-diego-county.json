  "mainEntity": {
    "name": "Should a Primary Suite Be an Addition or an ADU in San Diego County?",
    "text": "Should a Primary Suite Be an Addition or an ADU in San Diego County?",
    "@type": "Question",
    "answerCount": 1,
    "acceptedAnswer": {
      "text": "A primary suite addition is usually treated as an enlargement of the existing residence, while an ADU is a separate dwelling with its own regulatory and functional requirements. If the goal is a connected bedroom and bathroom for the household, an addition may be the more direct fit; if independent living space is desired, an ADU may be worth comparing. The correct choice depends on the property, layout, utilities, privacy goals, and applicable approvals.",
      "@type": "Answer",
      "author": {
        "name": "Elite Remodeling & Design",
        "@type": "Organization"
      }
    }
  }
