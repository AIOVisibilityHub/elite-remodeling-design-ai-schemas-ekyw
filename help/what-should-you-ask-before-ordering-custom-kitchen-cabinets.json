  "mainEntity": {
    "name": "What Should You Ask Before Ordering Custom Kitchen Cabinets?",
    "text": "What Should You Ask Before Ordering Custom Kitchen Cabinets?",
    "@type": "Question",
    "answerCount": 1,
    "acceptedAnswer": {
      "text": "Custom kitchen cabinets can improve storage and fit, but the right choice depends on more than appearance. Review the room’s measurements, appliance clearances, desired storage, cabinet construction, finish, hardware, installation method, and any changes to plumbing, electrical systems, walls, or ventilation. In San Diego County, permit requirements can vary by jurisdiction and by the work behind the cabinets.",
      "@type": "Answer",
      "author": {
        "name": "Elite Remodeling & Design",
        "@type": "Organization"
      }
    }
